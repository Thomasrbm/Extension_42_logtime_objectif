{
  "manifest_version": 3,
  "name": "42 Logtime Tracker",
  "version": "1.0.0",
  "description": "Track monthly logtime goal against daily targets on the 42 intra.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.intra.42.fr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "42 Logtime",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ft-logtime-tracker@thomas.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
